{
  "default_agent": "CODING_AGENT_CLAUDE_CODE",
  "enabled_agents": [
    {
      "agent": "CODING_AGENT_CLAUDE_CODE",
      "config": {
        "models": {
          "model_services": [
            "${CATALOG}.${SCHEMA}.reasoning_claude_opus",
            "${CATALOG}.${SCHEMA}.reasoning_claude_sonnet",
            "${CATALOG}.${SCHEMA}.fast_claude_haiku",
            "${CATALOG}.${SCHEMA}.oss_glm",
            "${CATALOG}.${SCHEMA}.oss_kimi",
            "${CATALOG}.${SCHEMA}.oss_deepseek"
          ]
        },
        "default_models": {
          "default_model": "${CATALOG}.${SCHEMA}.reasoning_claude_sonnet",
          "default_opus_model": "${CATALOG}.${SCHEMA}.reasoning_claude_opus",
          "default_sonnet_model": "${CATALOG}.${SCHEMA}.reasoning_claude_sonnet",
          "default_haiku_model": "${CATALOG}.${SCHEMA}.fast_claude_haiku"
        },
        "smart_routing": {
          "enabled": false
        },
        "tracing": {
          "enabled": true
        },
        "agent_native_settings": {
          "allowManagedMcpServersOnly": true
        }
      }
    },
    {
      "agent": "CODING_AGENT_CODEX",
      "config": {
        "models": {
          "model_services": [
            "${CATALOG}.${SCHEMA}.reasoning_gpt",
            "${CATALOG}.${SCHEMA}.fast_gpt_mini",
            "${CATALOG}.${SCHEMA}.oss_glm",
            "${CATALOG}.${SCHEMA}.oss_kimi",
            "${CATALOG}.${SCHEMA}.oss_deepseek"
          ]
        },
        "default_models": {
          "default_model": "${CATALOG}.${SCHEMA}.reasoning_gpt"
        },
        "smart_routing": {
          "enabled": false
        },
        "tracing": {
          "enabled": true
        }
      }
    }
  ],
  "mcp_servers": {
    "names": [
      "system.ai.dbsql",
      "system.ai.github"
    ]
  },
  "skills": {
    "unity_catalog_location": "${CATALOG}.${SCHEMA}"
  },
  "smart_defaults": {
    "budget_id": "${BUDGET_ID}",
    "tiers": [
      {
        "spending_percentage": 0.8,
        "recommended_agent": "CODING_AGENT_CLAUDE_CODE",
        "recommended_model": "${CATALOG}.${SCHEMA}.fast_claude_haiku"
      },
      {
        "spending_percentage": 0.95,
        "recommended_agent": "CODING_AGENT_CLAUDE_CODE",
        "recommended_model": "${CATALOG}.${SCHEMA}.oss_glm"
      }
    ]
  }
}
